logger = logging.getLogger(__name__)

# ──────────────────────────────────────────────────────────
# 平台识别
# ──────────────────────────────────────────────────────────

_PLATFORM_PATTERNS = {
    "xiaohongshu":  r"xiaohongshu\.com",
    "douban":       r"douban\.com",
    "wechat_mp":    r"mp\.weixin\.qq\.com",
    "zhihu":        r"zhihu\.com",
    "baike_baidu":  r"baike\.baidu\.com",
    "sspai":        r"sspai\.com",
    "wikipedia":    r"wikipedia\.org",
}

_PLATFORM_LABELS = {
    "xiaohongshu":  "小红书",
    "douban":       "豆瓣",
    "wechat_mp":    "微信公众号",
    "zhihu":        "知乎",
    "baike_baidu":  "百度百科",
    "sspai":        "少数派",
    "wikipedia":    "Wikipedia",
    "generic":      "通用网页",
    "text":         "纯文本",
    "file":         "文件上传",
}


def _detect_platform(url: str) -> str:
    """根据 URL 域名识别平台，返回平台标识或 'generic'"""
    for name, pattern in _PLATFORM_PATTERNS.items():
        if re.search(pattern, url):
            return name
    return "generic"


