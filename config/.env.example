# ─────────────────────────────────────────────────────────────
# Knowledge Agent 环境变量示例
# 复制此文件为 .env 并填入真实值
# cp config/.env.example config/.env
# ─────────────────────────────────────────────────────────────

# LLM 配置
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 浏览器设置
BROWSER_CHANNEL=chrome
ACTION_DELAY_MIN=5
ACTION_DELAY_MAX=12

# 站点配置
ACTIVE_SITE=boss

# ── 飞书自建应用 ──
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your-feishu-app-secret

# ── 飞书多维表格 ──
FEISHU_APP_TOKEN=your-app-token
FEISHU_TABLE_ID=your-table-id

# ── 图片 inbox 目录（留空则用默认 data/inbox/）──
INBOX_DIR=

# ─────────────────────────────────────────────────────────────
# 企业微信自建应用（P0 微信入口）
# 注册教程见 WECHAT_SETUP.md
# ─────────────────────────────────────────────────────────────
# 企业 CorpID（企业微信管理后台 → 我的企业 → 企业信息 → 企业ID）
WECOM_CORP_ID=your-corp-id

# 应用 Secret（企业微信管理后台 → 应用管理 → 自建应用 → 对应应用的Secret）
WECOM_CORP_SECRET=your-corp-secret

# 应用 AgentID（同上页面）
WECOM_AGENT_ID=1000002

# 回调 Token（自建应用 → 接收消息 → 自己填写的 Token）
WECOM_TOKEN=your-token

# 回调 EncodingAESKey（同上，43位随机字符串）
WECOM_AES_KEY=your-encoding-aes-key

# ─────────────────────────────────────────────────────────────
# 微信客服（P0.5 个人微信接入·方案B·主动拉取）
# ─────────────────────────────────────────────────────────────
# 客服账号 OpenKfId（企业微信管理后台 → 微信客服 → 点击客服账号名称）
WECOM_KF_OPEN_ID=your-open-kfid

# 客服专用 Secret（微信客服 → API → 获取凭证）
# 如果找不到，也可以复用 WECOM_CORP_SECRET
WECOM_KF_SECRET=

# 客服回调 Token（微信客服回调配置中填写）
WECOM_KF_TOKEN=your-kf-token

# 客服回调 EncodingAESKey（同上，43位随机字符串）
WECOM_KF_AES_KEY=your-kf-encoding-aes-key

# ─────────────────────────────────────────────────────────────
# Cloudflare Worker 云端同步（P0 企微链路云端化）
# ─────────────────────────────────────────────────────────────
# Worker URL（需绑定自定义域名，workers.dev 国内不可达）
CF_WORKER_URL=https://wechat.your-domain.top

# 同步 API 认证密钥（自生成 UUID，与 Worker 端 wrangler secret put SYNC_API_KEY 保持一致）
CF_SYNC_API_KEY=your-sync-api-key
